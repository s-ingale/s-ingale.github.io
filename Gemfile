# Only needed if you want to preview the site LOCALLY.
# You do NOT need this to publish — GitHub Pages builds it for you.
#
#   gem install bundler jekyll
#   bundle install
#   bundle exec jekyll serve   # → http://localhost:4000
source "https://rubygems.org"
gem "github-pages", group: :jekyll_plugins
gem "webrick"      # required for local serve on Ruby 3+
